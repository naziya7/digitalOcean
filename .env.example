# HTTP
HTTP_PORT=8080

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=thumbnails

# Local file storage root (contains originals/ and thumbnails/)
DATA_DIR=./data

# Upload / resize limits
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REQUEST=5
MAX_IMAGE_PIXELS=25000000
MAX_CUSTOM_DIMENSION=2000
